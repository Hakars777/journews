{
  "name": "journews",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && node scripts/ensure-sqlite-db.mjs && npm run prisma:migrate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "node scripts/prisma.mjs migrate dev --skip-seed",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:studio": "node scripts/prisma.mjs studio",
    "postinstall": "npm run prisma:generate",
    "wp:import": "node --env-file=.env scripts/wp-import.mjs"
  },
  "dependencies": {
