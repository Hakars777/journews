# ── Database ─────────────────────────────────────────────────────────────────
# Use Supabase SESSION pooler (port 5432) — Prisma requires session mode.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# IMPORTANT: paste the raw URL — do NOT wrap in quotes in Hostinger's env panel.
# DO NOT use transaction pooler (port 6543) — prisma migrate deploy will fail.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Must match your actual production domain exactly (no trailing slash).
NEXTAUTH_URL=https://your-domain.tld
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-random-32-char-secret

# ── Site (sitemap / RSS base URL) ─────────────────────────────────────────────
SITE_URL=https://your-domain.tld

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Media storage ──────────────────────────────────────────────────────────────
# Recommended: Cloudflare R2 for images and uploaded files.
MEDIA_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=media
# Use your custom CDN/domain here if you connect one to the bucket.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_REGION=auto

# Optional fallback: Supabase Storage
# MEDIA_STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=media
