############################################
# Jour News (Next.js + Prisma + NextAuth)
############################################

# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Optional: used for sitemap/rss if NEXTAUTH_URL is not set.
# SITE_URL="https://journews.example"

# Media storage provider: local | supabase | r2
# If omitted, the app auto-selects: R2 -> Supabase -> local.
# MEDIA_STORAGE_PROVIDER="local"

# Supabase Storage (optional production media uploads)
# Create a public bucket named `media` or set a custom bucket via SUPABASE_STORAGE_BUCKET.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="media"

# Cloudflare R2 (recommended for production media uploads)
# R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET="media"
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
# Optional, defaults to "auto"
# R2_REGION="auto"

