############################################
# Jour News (Next.js + Prisma + NextAuth)
############################################

# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Optional: used for sitemap/rss if NEXTAUTH_URL is not set.
# SITE_URL="https://journews.example"

# Supabase Storage (recommended for production media uploads)
# Create a public bucket named `media` or set a custom bucket via SUPABASE_STORAGE_BUCKET.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="media"

