generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  passwordHash String
  role         UserRole @default(EDITOR)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news News[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news News[]

  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news NewsTag[]
}

model News {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  lead         String
  contentHtml  String
  coverImage   String?
  galleryImages Json?

  sourceName String?
  sourceUrl  String?

  status        NewsStatus @default(DRAFT)
  isTop         Boolean    @default(false)
  isEditorsPick Boolean    @default(false)

  views Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  tags NewsTag[]

  publishedAt DateTime?
  scheduledAt DateTime?

  viewEvents NewsView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([views])
  @@index([status])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([isTop])
  @@index([isEditorsPick])
}

model NewsTag {
  newsId String
  tagId  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([newsId, tagId])
  @@index([tagId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NewsView {
  id         String   @id @default(cuid())
  newsId     String
  createdAt  DateTime @default(now())
  viewerHash String?

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId, createdAt])
  @@index([createdAt])
}

